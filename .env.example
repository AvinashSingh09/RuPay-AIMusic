# Server-only Google Gemini API Key for Lyria Music Generation (never exposed to browser)
# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional default Lyria model (`lyria-3.5`, `lyria-3-clip-preview`, `lyria-3-pro-preview`, `lyria-realtime-exp`)
LYRIA_MODEL=lyria-3.5

# Cloudinary Configuration for Unsigned Audio Uploads & QR Code Download
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_here
VITE_CLOUDINARY_FOLDER=your_upload_folder_here
